# Copy to .env (gitignored) and fill in, or export these directly in your shell/MCP client config.

# OAuth client from Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# application type "Desktop app"). Download the JSON and copy client_id/client_secret from it.
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=

# Obtained by running `admob-mcp-authorize` once (opens a browser for the one-time Google
# consent flow). Never commit this — it's a long-lived credential.
ADMOB_REFRESH_TOKEN=
